{
  "name": "trading-desk-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "An incident-response agent, built on TrueForge, that investigates paper-trading account anomalies and pauses for human approval before anything irreversible.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "mcp-server",
    "client",
    "ui"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "typescript-eslint": "^8.3.0"
  }
}